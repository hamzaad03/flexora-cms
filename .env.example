# ----------------------------------------------------------------------------
# FlxOraCMS environment. Copy to `.env` and fill in real values.
# Never commit `.env`.
# ----------------------------------------------------------------------------

# MySQL connection string (Prisma).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/flxoracms"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-32-byte-base64-secret"

# Public base URL of the site (used for canonical URLs, sitemap, OG, callbacks).
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Absolute or relative path to the persistent storage directory
# (themes + media). Must be writable and persistent on your host.
STORAGE_DIR="./storage"

# Node environment: development | production | test
NODE_ENV="development"

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL="info"

# Max Server Action request body size for rich builder payloads and admin uploads.
# Supports values accepted by Next.js/bytes, e.g. 10mb, 25mb, 500kb.
SERVER_ACTIONS_BODY_SIZE_LIMIT="25mb"
