{% layout 'layouts/base' %}
{% block content %}
  <section class="archive">
    <h1 class="archive__title">{{ page.title }}</h1>
    {% if posts.size > 0 %}
      <ul class="post-list">
        {% for post in posts %}
          <li class="post-list__item">
            <a href="{{ post.url }}">
              <h2>{{ post.title }}</h2>
              {% if post.excerpt %}<p>{{ post.excerpt }}</p>{% endif %}
            </a>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p>Nothing here yet.</p>
    {% endif %}
  </section>
{% endblock %}
