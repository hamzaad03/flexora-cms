{% layout 'layouts/base' %}
{% block content %}
  <section class="page-hero">
    <div class="container">
      <h1>{{ page.title }}</h1>
      <p class="page-hero__lead">News, guides and updates.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      {% if posts.size > 0 %}
        <ul class="post-list">
          {% for post in posts %}
            <li class="post-card">
              <a href="{{ post.url }}">
                {% if post.published_at %}
                  <time datetime="{{ post.published_at | date: '%Y-%m-%d' }}">{{ post.published_at | date: '%B %e, %Y' }}</time>
                {% endif %}
                <h2>{{ post.title }}</h2>
                {% if post.excerpt %}<p>{{ post.excerpt }}</p>{% endif %}
                <span class="post-card__more">Read more &rarr;</span>
              </a>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="empty">Nothing here yet.</p>
      {% endif %}
    </div>
  </section>
{% endblock %}
