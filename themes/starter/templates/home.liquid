{% layout 'layouts/base' %}
{% block content %}
  <section class="hero">
    <div class="container hero__inner">
      <p class="hero__eyebrow">Build &middot; Design &middot; Grow</p>
      <h1 class="hero__title">{{ page.title }}</h1>
      {% if page.excerpt %}<p class="hero__lead">{{ page.excerpt }}</p>{% endif %}
      <div class="hero__actions">
        <a class="btn btn--primary" href="/contact">Get in touch</a>
        <a class="btn btn--ghost" href="/services">Our services</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="prose prose--home">{{ page.content }}</div>
    </div>
  </section>
{% endblock %}
