{% layout 'layouts/base' %}
{% block content %}
  <article class="page">
    <header class="page__header">
      <h1>{{ page.title }}</h1>
    </header>
    {% if page.featured_image %}
      <img class="page__featured" src="{{ page.featured_image }}" alt="{{ page.title }}" />
    {% endif %}
    <div class="prose">{{ page.content }}</div>
  </article>
{% endblock %}
