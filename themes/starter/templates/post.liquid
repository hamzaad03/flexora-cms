{% layout 'layouts/base' %}
{% block content %}
  <article class="post">
    <header class="post__header">
      <h1>{{ page.title }}</h1>
      {% if page.published_at %}
        <time datetime="{{ page.published_at | date: '%Y-%m-%d' }}">
          {{ page.published_at | date: '%B %e, %Y' }}
        </time>
      {% endif %}
    </header>
    {% if page.featured_image %}
      <img class="post__featured" src="{{ page.featured_image }}" alt="{{ page.title }}" />
    {% endif %}
    <div class="prose">{{ page.content }}</div>
  </article>
{% endblock %}
